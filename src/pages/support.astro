---
import BaseLayout from '@/layouts/BaseLayout'
import TitlePage from '@/components/TitlePage'
---

<BaseLayout
	title='Support'
	description='Get in touch with the Swift Published team for questions, feedback, or contributions.'
>
	<TitlePage title='Support' />

	<div class='prose dark:prose-invert max-w-none mt-8'>
		<p>
			If you have questions, suggestions, or feedback about an article, please leave a comment at
			the end of the corresponding article.
		</p>
		<p>
			If you want to write with us, have general feedback, or just want to say hi, you can reach us
			at{' '}
			<a href='mailto:hello@swiftpublished.in'>hello@swiftpublished.in</a>. We are always happy to
			help and generally reply within 24 hours.
		</p>
		<hr />
		<p>with ❤️</p>
		<p>swiftpublished team</p>
	</div>
</BaseLayout>
