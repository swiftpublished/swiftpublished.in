---
import BaseLayout from '@/layouts/BaseLayout'
import TitlePage from '@/components/TitlePage'
import { AUTHORS } from '@/data/authors'
---

<BaseLayout
	title='Authors'
	description='Meet the talented authors behind Swift Published, sharing their expertise and passion for Swift and iOS development.'
>
	<TitlePage title='Authors' />

	<p class='mt-4 text-stone-600 dark:text-stone-300 max-w-3xl'>
		Meet the team behind Swift Published — a small group of iOS developers sharing what we learn,
		build, and ship.
	</p>

	<div class='grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-2 gap-6 mt-8'>
		{
			AUTHORS.map((author) => (
				<a
					href={`/authors/${author.id}`}
					class='flex gap-5 items-start p-6 rounded-xl border border-stone-200 dark:border-stone-700 hover:bg-stone-50 dark:hover:bg-stone-900 transition-colors'
				>
					<img
						src={author.photo}
						alt={author.photoAlt}
						class='w-24 h-24 rounded-full object-cover flex-shrink-0'
					/>
					<div class='flex flex-col gap-1'>
						<p class='text-xl font-semibold'>{author.name}</p>
						<p class='text-sm text-stone-500 dark:text-stone-400 capitalize'>
							{author.roles.join(' · ')} · {author.location}
						</p>
						<p class='text-sm text-stone-600 dark:text-stone-300 mt-2 line-clamp-3'>
							{author.bio[0]}
						</p>
					</div>
				</a>
			))
		}
	</div>
</BaseLayout>
