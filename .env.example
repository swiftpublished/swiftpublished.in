# Copy to .env.local and fill in real values. Never commit .env.local.

# Notion internal integration token (begins with `secret_` or `ntn_`).
# Get one at: https://www.notion.so/profile/integrations
NOTION_TOKEN=

# Notion database ID — the 32-char UUID of the articles database
# (with or without dashes). Find it under /v1/databases/<id> on the API or
# by inspecting the database URL.
NOTION_DATABASE_ID=
